# /etc/systemd/system/entropywatcher-nas.timer
[Unit]
Description=EntropyWatcher NAS Delta-Scan (3x täglich, vor Backup-Fenstern)

[Timer]
# ~2h vor backup-pipeline (04 / 12 / 20) — nicht stündlich (mergerfs-Schonung)
OnCalendar=*-*-* 02:00:00
OnCalendar=*-*-* 10:00:00
OnCalendar=*-*-* 18:00:00
AccuracySec=1m
RandomizedDelaySec=5min
Persistent=true

Unit=entropywatcher-nas.service

[Install]
WantedBy=timers.target
