# /etc/systemd/system/entropywatcher-nas.timer
[Unit]
Description=EntropyWatcher NAS scan (4x nightly, low NAS impact)

[Timer]
# 4× in der Ruhephase 02–06 (nicht stündlich — mergerfs-Schonung)
OnCalendar=*-*-* 02:20:00
OnCalendar=*-*-* 03:20:00
OnCalendar=*-*-* 04:20:00
OnCalendar=*-*-* 05:20:00
AccuracySec=1m
RandomizedDelaySec=5min
Persistent=true

Unit=entropywatcher-nas.service

[Install]
WantedBy=timers.target
