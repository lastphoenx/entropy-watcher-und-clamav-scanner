[Unit]
Description=EntropyWatcher ClamAV Scan (WEEKLY full)
Wants=network-online.target clamav-daemon.service
After=network-online.target clamav-daemon.service
RequiresMountsFor=/srv/nas

[Service]
SyslogIdentifier=ew-nas-av-weekly

Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apps/entropywatcher
Environment=PYTHONNOUSERSITE=1
Environment=NAS_HEAVY_OPS_FAIL_FAST=1
# Nur Weekly: ALLOW_HOURS fängt Persistent-Nachholen tagsüber ab (Timer So 03:00)
Environment=NAS_HEAVY_OPS_ALLOW_HOURS=02-06
EnvironmentFile=-/opt/apps/entropywatcher/config/common.env
EnvironmentFile=-/opt/apps/entropywatcher/config/nas-av-weekly.env

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

ExecStart=/opt/apps/rtb/with_nas_heavy_ops_lock.sh /opt/apps/entropywatcher/venv/bin/python /opt/apps/entropywatcher/main/entropywatcher.py av-scan --paths ${SCAN_PATHS}

TimeoutStartSec=8h

[Install]
WantedBy=multi-user.target
