[Unit]
Description=EntropyWatcher Scan (Delta)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/nas
# Kein Conflicts= zu Backup/AV — Koordination nur via nas_heavy_ops_lock (busy → skip, kein SIGTERM).

[Service]
SyslogIdentifier=ew-nas-scan

Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apps/entropywatcher
EnvironmentFile=-/opt/apps/entropywatcher/config/common.env
EnvironmentFile=-/opt/apps/entropywatcher/config/nas.env
Environment=PYTHONNOUSERSITE=1
Environment=NAS_HEAVY_OPS_FAIL_FAST=1
Environment=NAS_HEAVY_OPS_ALLOW_HOURS=02-06
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# optional (cgroups v2 / Debian 12):
# IOWeight=50
# CPUWeight=10


ExecStart=/opt/apps/rtb/with_nas_heavy_ops_lock.sh /opt/apps/entropywatcher/venv/bin/python /opt/apps/entropywatcher/main/entropywatcher.py scan --paths "${SCAN_PATHS}"

TimeoutStartSec=2h
