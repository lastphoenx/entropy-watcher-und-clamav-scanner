# /etc/systemd/system/backup-pipeline.service
[Unit]
Description=Backup Pipeline (RTB + pCloud POOL)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/nas
OnSuccess=monitoring-reports.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apps/pcloud-tools/main

ExecStartPre=/bin/mkdir -p /var/log/backup
ExecStart=/opt/apps/rtb/rtb_pool_wrapper.sh

# Safety-Gate: 0 = auch bei YELLOW starten (pi-nas Produktion)
Environment=SAFETY_GATE_STRICT=0
Environment=NAS_HEAVY_OPS_FAIL_FAST=1
Environment=RTB_OOM_SCORE_ADJ=500
Environment=PCLOUD_MAIN_DIR=/opt/apps/pcloud-tools/main
# KEIN NAS_HEAVY_OPS_ALLOW_HOURS — alle 3 Backup-Slots (04/12/20) müssen laufen
# Trigger-Check: RTB_TRIGGER_MODE=signature (Default in rtb) — kein rsync -ni Vollbaum
# Logging nur via rtb_pool_wrapper.sh → /var/log/backup/rtb_wrapper.log (kein StandardOutput hier — kein Doppel-Tee)

MemoryMax=2G
MemorySwapMax=256M
OOMScoreAdjust=500
SuccessExitStatus=1

Nice=10
IOSchedulingClass=idle
CPUWeight=100
IOWeight=50

TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
