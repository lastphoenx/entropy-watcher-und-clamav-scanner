# /etc/systemd/system/backup-pipeline.service
[Unit]
Description=Backup Pipeline (RTB + pCloud)
Wants=network-online.target
After=network-online.target
OnSuccess=monitoring-reports.service

[Service]
Type=oneshot
User=<USER>
WorkingDirectory=/opt/apps/rtb
# Bei aktivem pCloud-Upload sofort überspringen (kein 2h flock-Warten, kein rsync-OOM)
Environment=NAS_HEAVY_OPS_FAIL_FAST=1
# Schwere Pipeline (RTB + pCloud-Catch-up) nur nachts — tagsüber kein mergerfs-Sturm
Environment=NAS_HEAVY_OPS_ALLOW_HOURS=02-06
Environment=RTB_OOM_SCORE_ADJ=500
ExecStart=/opt/apps/rtb/rtb_wrapper.sh
StandardOutput=append:/var/log/backup/rtb_wrapper.log
StandardError=append:/var/log/backup/rtb_wrapper.log

# RAM-Deckel: rsync -ni über mergerfs frisst GB — lieber rsync killen als ganzen Pi
# Vollständig: pcloud-tools/systemd/backup-pipeline.service.d/memory-limit.conf.example
MemoryMax=3G
MemorySwapMax=512M
OOMScoreAdjust=500

# Exit-Code 1 = Safety-Gate YELLOW (normaler Skip, kein Fehler)
# Exit-Code 2 = Safety-Gate RED (echter Alarm → bleibt als Failed sichtbar)
SuccessExitStatus=1

# Resource limits (schonend für System)
Nice=10
IOSchedulingClass=idle
CPUWeight=100
IOWeight=50

