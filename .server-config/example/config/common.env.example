# common.env.example — anonymisiertes Template (keine Secrets im Git)
# Kopie auf dem Server: /opt/apps/entropywatcher/config/common.env
# Siehe docs/CONFIG.md und docs/NAS_FALSE_POSITIVES.md

# ============================================================================
# DATENBANK
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=entropywatcher
DB_USER=entropyuser
DB_PASS=CHANGE_ME

# ============================================================================
# MAIL
# ============================================================================
MAIL_ENABLE=1
MAIL_SMTP_HOST=mail.example.com
MAIL_SMTP_PORT=587
MAIL_STARTTLS=1
MAIL_SSL=0
MAIL_USER=alerts@example.com
MAIL_PASS=CHANGE_ME
MAIL_FROM=EntropyWatcher <alerts@example.com>
MAIL_TO=admin@example.com
MAIL_SUBJECT_PREFIX=[EntropyWatcher]
MAIL_MIN_ALERT_INTERVAL_MIN=30
# [burst]-Tag ab N neuen Flags; 0 = aus. Nach Deploy via scan_summary.flagged_new_count tunen.
MAIL_BURST_MIN=25
ALERT_STATE_FILE=/var/lib/entropywatcher/last_alert.txt

# ============================================================================
# ENTROPIE-SCHWELLWERTE
# ============================================================================
ALERT_ENTROPY_ABS=7.8
ALERT_ENTROPY_JUMP=0.2
USE_ENT=1
ENT_THRESHOLD=2097152
WORKERS=3

# ============================================================================
# HEALTH CHECK (Safety Gate — siehe nas.env für HEALTH_WINDOW_MIN pro Job)
# ============================================================================
HEALTH_FLAGGED_MAX=0
HEALTH_AV_FINDINGS_MAX=0
HEALTH_SAFEAGE_MIN=10

# ============================================================================
# EXCLUDES — Dateien komplett überspringen (kein Scan, kein DB-Eintrag)
# ============================================================================
EXCLUDES_MODE=glob
EXCLUDES=*/.git/objects/*,/boot/*,*/av-quarantine/*,*/.Spotlight-V100/*,\
*/node_modules/*,*/__pycache__/*,*.gz,*.xz,*.zip,*.tar,\
**/token.env,**/.Trash-*/**,**/@Recycle/**,\
/srv/nas/Backup/**,**/Backup/pbs2/**,**/Backup/pve2/**

# Honeyfiles (deployment-spezifisch — echte Pfade nur auf dem Server / in privater Doku):
# /root/.aws/credentials_XXXXX_YYYYMMDD,/root/.git-credentials_...

# ============================================================================
# SCORE_EXCLUDES — messen, aber nie flaggen (score_exempt)
# Glob **/._* matcht AppleDouble per Pfad UND Dateiname
# ============================================================================
SCORE_EXCLUDES_MODE=glob
SCORE_EXCLUDES=*.jpg,*.jpeg,*.png,*.gif,*.webp,*.mp4,*.mkv,*.avi,*.mp3,*.ogg,*.flac,\
*.iso,*.sqlite,*.db,*.gz,*.xz,*.zip,*.tar,*.7z,*.rar,\
**/.chunks/**,**/*.blob,**/*.fidx,**/*.gpg,**/.rnd,\
**/trusted.gpg.d/**,**/Paperless/media/documents/thumbnails/**,\
**/._*

# ============================================================================
# CLAMAV (global aus — nur in *-av.env auf 1 setzen)
# ============================================================================
CLAMAV_ENABLE=0
CLAMAV_USE_CLAMD=1
CLAMAV_EXCLUDES_MODE=glob
CLAMAV_EXCLUDES=*/av-quarantine/*,*/.cache/*,*/node_modules/*,*.iso,*.img

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=
