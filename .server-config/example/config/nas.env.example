# nas.env.example — NAS-Entropy-Scan (stündlich)
# Wird zusätzlich zu common.env geladen; überschreibt nur abweichende Werte.

SOURCE_LABEL=nas
SCAN_PATHS=/srv/nas

MAIL_FROM=NAS-EntropyWatcher <alerts@example.com>
MAIL_SUBJECT_PREFIX=[NAS-EntropyWatcher]
ALERT_STATE_FILE=/var/lib/entropywatcher/last_alert_nas.txt

# Stündlicher Timer → 75 Min Puffer (siehe docs/CONFIG.md)
HEALTH_WINDOW_MIN=75
